<Project>

  <!-- Build settings every published package needs, set for all projects so a library and the
       projects it references are built the same way. Each one yields to a value you set. -->
  <PropertyGroup>
    <!-- Source Link (built into the .NET 8+ SDK) records the commit and repository URL. -->
    <PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)'==''">true</PublishRepositoryUrl>
    <EmbedUntrackedSources Condition="'$(EmbedUntrackedSources)'==''">true</EmbedUntrackedSources>
    <Deterministic Condition="'$(Deterministic)'==''">true</Deterministic>
    <!-- Must be set before the SDK targets, which default it to false. -->
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)'==''">True</GenerateDocumentationFile>
    <!-- Normalizes the source paths in PDBs; only on CI, so local debugging keeps real paths. -->
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)'=='' AND '$(MSKit_IsDevEnv)'!='True'">true</ContinuousIntegrationBuild>

    <NuGetAudit Condition="'$(NuGetAudit)'==''">true</NuGetAudit>
    <NuGetAuditMode Condition="'$(NuGetAuditMode)'==''">all</NuGetAuditMode>
    <NuGetAuditLevel Condition="'$(NuGetAuditLevel)'==''">low</NuGetAuditLevel>

    <!-- The generated package readme links these pages. `auto` derives them from the repository
         host; set one empty in the csproj (or -p:MSKit_ReleasesUrl=) to leave the link out. -->
    <MSKit_ReleasesUrl Condition="'$(MSKit_ReleasesUrl)'==''">auto</MSKit_ReleasesUrl>
    <MSKit_IssuesUrl Condition="'$(MSKit_IssuesUrl)'==''">auto</MSKit_IssuesUrl>
    <!-- The generated readme's first level-1 heading; `auto` is the PackageId, empty keeps the README's. -->
    <MSKit_PackageReadmeTitle Condition="'$(MSKit_PackageReadmeTitle)'==''">auto</MSKit_PackageReadmeTitle>
  </PropertyGroup>

</Project>
